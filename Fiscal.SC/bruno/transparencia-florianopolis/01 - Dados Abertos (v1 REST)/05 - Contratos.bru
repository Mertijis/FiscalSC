meta {
  name: 05 - Contratos
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/rest/florianopolis/api/v1/contrato?periodo_inicial={{data_inicio}}&periodo_final={{data_fim_mes}}&inicio_registro=0&quantidade_registro={{quantidade_padrao}}
  body: none
  auth: none
}

params:query {
  periodo_inicial: {{data_inicio}}
  periodo_final: {{data_fim_mes}}
  inicio_registro: 0
  quantidade_registro: {{quantidade_padrao}}
  ~codigo_unidade: 0
}

headers {
  Accept: application/json
}

assert {
  res.status: in [200, 202]
  res.body.informacao: eq Contrato
  res.body.totalRegistros: isNumber
  res.body.registros: isDefined
}

tests {
  test("Status deve ser 200 (OK) ou 202 (Accepted)", function() {
    expect([200, 202]).to.include(res.getStatus());
  });

  test("Cabeçalho Content-Type deve ser JSON", function() {
    const contentType = res.getHeader('content-type') || '';
    expect(contentType.toLowerCase()).to.include('application/json');
  });

  test("Envelope de retorno deve ser do módulo Contrato", function() {
    const body = res.getBody();
    expect(body).to.be.an('object');
    expect(body.informacao).to.equal('Contrato');
    expect(body.totalRegistros).to.be.a('number');
  });

  test("Registros devem conter campos de contrato administrativo", function() {
    const body = res.getBody();
    expect(body.registros).to.be.an('array');
    if (body.registros.length > 0) {
      const item = body.registros[0].registro;
      expect(item).to.be.an('object');
      expect(item).to.have.property('contrato');
      expect(item.contrato).to.have.property('numero');
      expect(item.contrato).to.have.property('valorTotal');
    }
  });
}
