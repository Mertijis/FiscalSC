meta {
  name: 06 - Gestão de Pessoal
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/rest/florianopolis/api/v1/pessoal?referencia={{periodo_mes_ano}}&inicio_registro=0&quantidade_registro={{quantidade_padrao}}
  body: none
  auth: none
}

params:query {
  referencia: {{periodo_mes_ano}}
  inicio_registro: 0
  quantidade_registro: {{quantidade_padrao}}
  ~codigo_unidade: 0
}

headers {
  Accept: application/json
}

assert {
  res.status: in [200, 202]
  res.body.informacao: eq Pessoal
  res.body.totalRegistros: isNumber
  res.body.registros: isDefined
}

tests {
  test("Status deve ser 200 (OK) ou 202 (Accepted)", function() {
    expect([200, 202]).to.include(res.getStatus());
  });

  test("Cabeçalho Content-Type deve ser JSON", function() {
    const contentType = res.getHeader('content-type') || '';
    expect(contentType.toLowerCase()).to.include('application/json');
  });

  test("Envelope de retorno deve ser do módulo Pessoal", function() {
    const body = res.getBody();
    expect(body).to.be.an('object');
    expect(body.informacao).to.equal('Pessoal');
    expect(body.totalRegistros).to.be.a('number');
  });

  test("Registros devem conter identificação do servidor e matrícula", function() {
    const body = res.getBody();
    expect(body.registros).to.be.an('array');
    if (body.registros.length > 0) {
      const item = body.registros[0].registro;
      expect(item).to.be.an('object');
      expect(item).to.have.property('matricula');
      expect(item.matricula).to.have.property('numero');
      expect(item.matricula).to.have.property('nome');
      expect(item.matricula).to.have.property('cpf');
    }
  });
}
