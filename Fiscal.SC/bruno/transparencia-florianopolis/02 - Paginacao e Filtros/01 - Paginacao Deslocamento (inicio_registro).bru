meta {
  name: 01 - Paginação Deslocamento (inicio_registro)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/rest/florianopolis/api/v1/receita?periodo_inicial={{periodo_mes_ano}}&periodo_final={{periodo_mes_ano_fim}}&inicio_registro=5&quantidade_registro=5
  body: none
  auth: none
}

params:query {
  periodo_inicial: {{periodo_mes_ano}}
  periodo_final: {{periodo_mes_ano_fim}}
  inicio_registro: 5
  quantidade_registro: 5
}

headers {
  Accept: application/json
}

assert {
  res.status: in [200, 202]
  res.body.registros: isDefined
}

tests {
  test("Status deve ser 200 (OK) ou 202 (Accepted)", function() {
    expect([200, 202]).to.include(res.getStatus());
  });

  test("Quantidade de registros retornados deve respeitar o limite solicitado (5)", function() {
    const body = res.getBody();
    expect(body.registros).to.be.an('array');
    expect(body.registros.length).to.be.at.most(5);
  });
}
